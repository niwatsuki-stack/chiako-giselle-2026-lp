# 画像: 1年キャッシュ(immutable)
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon: 1週間
/images/favicon-*
  Cache-Control: public, max-age=604800, immutable
/images/apple-touch-icon.png
  Cache-Control: public, max-age=604800, immutable

# 音源: 1年キャッシュ
/audio/*
  Cache-Control: public, max-age=31536000, immutable

# Manifest: 1週間
/site.webmanifest
  Cache-Control: public, max-age=604800
  Content-Type: application/manifest+json

# robots / sitemap: 1日
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400

# HTML: revalidate(現状の Netlify デフォルトを明示)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Security headers(全パス共通)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), camera=(), microphone=(), geolocation=(), payment=()
  # HSTS: 1 年 + サブドメイン保護(preload 登録は別途 https://hstspreload.org/ で申請)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # CSP: inline JS/CSS 多用のため unsafe-inline 許可、 外部は明示
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://*.gstatic.com https://www.gstatic.com https://*.firebaseio.com https://*.firebaseapp.com https://www.googletagmanager.com https://www.google-analytics.com https://www.clarity.ms https://*.clarity.ms https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://*.firebaseio.com wss://*.firebaseio.com https://*.googleapis.com https://www.google-analytics.com https://*.clarity.ms https://*.facebook.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; report-uri /csp-report
